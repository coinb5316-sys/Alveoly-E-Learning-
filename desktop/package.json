{
  "name": "alveoly-desktop",
  "productName": "Alveoly E Learning",
  "version": "0.1.0",
  "description": "Alveoly E-Learning Platform desktop application",
  "main": "main.js",
  "author": {
    "name": "Alveoly",
    "email": "support@alveolye-learning.academy"
  },
  "homepage": "https://alveolye-learning.academy",
  "repository": {
    "type": "git",
    "url": "https://github.com/coinb5316-sys/Alveoly-E-Learning-.git"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --mac --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "sharp": "^0.33.0",
    "sharp-ico": "^0.1.5"
  },
  "build": {
    "appId": "com.alveoly.learning.desktop",
    "productName": "Alveoly E Learning",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Alveoly E Learning"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.education",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Education",
      "icon": "build/icon.png",
      "maintainer": "Alveoly <support@alveolye-learning.academy>"
    }
  }
}